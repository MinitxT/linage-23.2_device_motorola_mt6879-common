import /vendor/etc/init/hw/init.mtkgki.rc

# MTK project .rc configure

on post-fs-data

#Camera
    chmod 0660 /dev/MAINAF
    chown system camera /dev/MAINAF

    chmod 0660 /dev/MAINAF2
    chown system camera /dev/MAINAF2

    chmod 0660 /dev/SUBAF
    chown system camera /dev/SUBAF

# Torch
    chown system cameraserver /sys/devices/virtual/flashlight_core/flashlight/flashlight_torch
    chmod 0666 /sys/devices/virtual/flashlight_core/flashlight/flashlight_torch
    chown system cameraserver /sys/devices/virtual/flashlight_core/flashlight/flashlight_torch_level
    chmod 0666 /sys/devices/virtual/flashlight_core/flashlight/flashlight_torch_level
